# --- Servidor ---
NODE_ENV=development
PORT=3000
DATABASE_PATH=data/tolochahome.db

# --- JWT ---
# OBLIGATORIAS en produccion (minimo 32 caracteres). Genera con openssl rand -hex 32.
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Refresco de sesion (deslizante) ---
REFRESH_ROTATE_THRESHOLD=24h
REFRESH_GRACE_MS=60000

# --- Registro ---
# false = solo login, no se admiten nuevos registros.
REGISTRATION_ENABLED=true

# --- CORS ---
# "*" o lista de origenes separada por comas.
CORS_ORIGINS=*

# --- Estaticos del frontend (solo prod) ---
STATIC_DIR=/app/apps/web/dist
